<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btnTransportMode"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bordered_accent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/ivTransportIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_car"
        app:tint="@color/neo_mint_accent" />

    <TextView
        android:id="@+id/tvTransportText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Driving"
        android:textColor="@color/neo_mint_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>